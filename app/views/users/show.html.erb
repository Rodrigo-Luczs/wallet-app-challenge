<h1 class="mb-4">
  <%= @user.name %>
</h1>

<div class="card mb-4">
  <div class="card-body">

    <p>
      <strong>Email:</strong>
      <%= @user.email %>
    </p>

    <p>
      <strong>Saldo:</strong>
      R$ <%= @user.wallet.balance %>
    </p>

  </div>
</div>

<h2 class="mb-3">Nova Transação</h2>

<div class="card mb-4">
  <div class="card-body">

    <%= form_with url: transaction_user_path(@user), method: :post, local: true do |form| %>

      <div class="mb-3">
        <%= form.label :amount, "Valor", class: "form-label" %>

        <%= form.number_field :amount,
          step: 0.01,
          class: "form-control"
        %>
      </div>

      <div class="mb-3">
        <%= form.label :operation, "Operação", class: "form-label" %>

        <%= form.select :operation,
          [
            ["Crédito", "credit"],
            ["Débito", "debit"]
          ],
          {},
          class: "form-select"
        %>
      </div>

      <div>
        <%= form.submit "Salvar",
          class: "btn btn-primary"
        %>
      </div>

    <% end %>

  </div>
</div>

<h2 class="mb-3">Transações</h2>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Tipo</th>
      <th>Valor</th>
      <th>Data</th>
    </tr>
  </thead>

  <tbody>

    <% @user.wallet.transactions.order(created_at: :desc).each do |transaction| %>

      <tr>

        <td>
          <%= transaction.operation == "credit" ? "Crédito" : "Débito" %>
        </td>

        <td>
          R$ <%= transaction.amount %>
        </td>

        <td>
          <%= transaction.created_at.strftime("%d/%m/%Y %H:%M") %>
        </td>

      </tr>

    <% end %>

  </tbody>
</table>

<%= link_to "Voltar",
  users_path,
  class: "btn btn-secondary mt-3"
%>