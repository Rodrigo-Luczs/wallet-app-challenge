<h1 class="mb-4">Usuários</h1>

<%= link_to "Novo Usuário",
  new_user_path,
  class: "btn btn-primary mb-4"
%>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Nome</th>
      <th>Email</th>
      <th>Ações</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>

        <td>
          <%= link_to user.name, user_path(user) %>
        </td>

        <td>
          <%= user.email %>
        </td>

        <td>

          <%= link_to "Editar",
            edit_user_path(user),
            class: "btn btn-warning btn-sm"
          %>

          <%= button_to "Excluir",
            user_path(user),
            method: :delete,
            class: "btn btn-danger btn-sm",
            data: {
              turbo_confirm: "Tem certeza?"
            }
          %>

        </td>

      </tr>
    <% end %>
  </tbody>
</table>